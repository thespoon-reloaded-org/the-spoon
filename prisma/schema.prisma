// ============================================================================
//  TheSpoon — modèle de données
//
//  Volontairement minimal. On ne modélise pas l'entreprise fictive au complet
//  avant d'écrire du produit : chaque modèle arrive avec l'écran qui en a
//  besoin, pas avant. Voir README.md.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Un restaurant partenaire, tel qu'affiché côté dîneur (recherche + fiche).
/// Les champs de gestion interne (commission, contact, fiche technique...)
/// arriveront avec l'espace restaurant et le BO admin.
model Restaurant {
  id            String   @id @default(cuid())
  nom           String
  ville         String
  cuisine       String
  adresse       String
  horaires      String?
  description   String?
  capacite      Int?
  noteCuilleres Float?
  nombreAvis    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  platsCuillere PlatCuillere[]
  bookings      Booking[]
  avis          Avis[]
  contacts      RestaurantContact[]

  @@index([ville])
  @@index([cuisine])
}

/// Un plat signature « à la cuillère » — le cœur du concept TheSpoon : des
/// restaurants où on mange à la cuillère (soupes, plats mijotés, risottos...),
/// pas juste une note en cuillères. Sert la mise en avant sur la landing.
model PlatCuillere {
  id           String     @id @default(cuid())
  nom          String
  description  String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

// ----------------------------------------------------------------------------
//  Socle partenaires & staff. Identité seule, pas encore de connexion : "Auth
//  restaurant partenaire" et "Auth staff TheSpoon & permissions" sont des
//  stories séparées, pas encore démarrées.
// ----------------------------------------------------------------------------

/// Un gérant ou un chef de salle, côté restaurant partenaire.
enum RoleContactRestaurant {
  GERANT
  CHEF_DE_SALLE
}

/// Le contact d'un restaurant partenaire — pas un dîneur. Rattaché à son
/// établissement, c'est lui qui contestera une facture (voir "Contestations &
/// litiges").
model RestaurantContact {
  id           String                @id @default(cuid())
  restaurantId String
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nom          String
  email        String
  role         RoleContactRestaurant
  createdAt    DateTime              @default(now())

  @@index([restaurantId])
}

/// L'organigramme interne TheSpoon. Pas de rôles détaillés ici (instructeur
/// litiges, validateur avoirs...) — ça arrivera avec "Auth staff TheSpoon &
/// permissions".
model Staff {
  id        String   @id @default(cuid())
  nom       String
  email     String   @unique
  role      String?
  createdAt DateTime @default(now())
}

/// Statut d'une réservation. Pas de distinction "honorée" / "no-show" ici —
/// ce sera nécessaire pour la facturation (voir "Schéma réservation &
/// facturation") mais n'est pas encore modélisé.
enum StatutReservation {
  CONFIRMEE
  ANNULEE
}

/// Une réservation faite par un dîneur connecté sur la fiche établissement.
/// Pas de gestion de disponibilité/capacité ici — ce sera une story séparée
/// (espace restaurant).
model Booking {
  id           String            @id @default(cuid())
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  couverts     Int
  statut       StatutReservation @default(CONFIRMEE)
  createdAt    DateTime          @default(now())

  @@index([restaurantId])
  @@index([userId])
}

/// Un avis déposé par un dîneur après son passage dans un restaurant — un
/// seul avis par (restaurant, dîneur), modifiable (voir `deposerAvis`, qui
/// fait un upsert et recalcule `Restaurant.noteCuilleres`/`nombreAvis` à
/// chaque dépôt). Pas de modération pour l'instant : décision volontairement
/// pas prise ici, voir le ticket Notion "Modération des avis".
model Avis {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteCuilleres Int
  commentaire   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([restaurantId, userId])
  @@index([restaurantId])
}

// ----------------------------------------------------------------------------
//  Auth dîneur (better-auth). Restaurant partenaire et staff TheSpoon sont
//  des stories séparées, pas encore démarrées — un seul modèle User pour
//  l'instant, pas de champ "rôle".
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
//  Exception assumée : la relation `bookings` ci-dessous est ajoutée à la
//  main, better-auth ne gère que les champs d'auth — à recontrôler si le
//  schéma est régénéré.
// ----------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  avis          Avis[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
