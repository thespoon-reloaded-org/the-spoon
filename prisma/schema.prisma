// ============================================================================
//  TheSpoon — modèle de données
//
//  Volontairement minimal. On ne modélise pas l'entreprise fictive au complet
//  avant d'écrire du produit : chaque modèle arrive avec l'écran qui en a
//  besoin, pas avant. Voir README.md.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Un restaurant partenaire, tel qu'affiché côté dîneur (recherche + fiche).
/// Les champs de gestion interne (commission, contact, fiche technique...)
/// arriveront avec l'espace restaurant et le BO admin.
model Restaurant {
  id                    String    @id @default(cuid())
  nom                   String
  ville                 String
  cuisine               String
  adresse               String
  horaires              String?
  description           String?
  capacite              Int?
  /// Délai (en heures) avant le créneau au-delà duquel une annulation est
  /// jugée tardive — `null` : pas de politique définie. Prérequis du délai
  /// minimal d'annulation côté dîneur et du futur motif de contestation
  /// `annulation_tardive`, ni l'un ni l'autre pas encore appliqués.
  delaiAnnulationHeures Int?
  noteCuilleres         Float?
  nombreAvis            Int       @default(0)
  /// Horodatage de la dernière photo uploadée (même mécanique que
  /// `PlatCuillere.photoMisAJourLe` — voir src/lib/photos.ts). `null` = pas
  /// de photo, sert aussi de cache-bust pour `/api/restaurants/[id]/photo`.
  photoMisAJourLe       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  platsCuillere      PlatCuillere[]
  bookings           Booking[]
  avis               Avis[]
  contacts           RestaurantContact[]
  horairesFermes     HoraireFermeture[]
  exceptionsHoraires ExceptionHoraire[]
  journalAudit       JournalAuditRestaurant[]
  factures           Facture[]

  @@index([ville])
  @@index([cuisine])
}

/// Le planning récurrent (non daté) du restaurant : un jour de semaine (ou un
/// seul créneau de ce jour) fermé toutes les semaines — l'horaire d'ouverture
/// classique. `jourSemaine` suit l'index ISO (0 = lundi … 6 = dimanche, voir
/// `jourSemaineIso`), pas `Date.getDay()`. `creneau: null` ferme la journée
/// entière. Vérifié à la création d'une réservation avec les exceptions
/// ponctuelles ci-dessous (`ExceptionHoraire`), qui le recouvrent pour une
/// date précise. Pas de contrainte d'unicité en base : une valeur nullable
/// dans une clé composite ne garantit rien sous PostgreSQL, l'action serveur
/// vérifie avant d'écrire.
model HoraireFermeture {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  jourSemaine  Int
  creneau      String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, jourSemaine])
}

/// Une exception ponctuelle sur une date précise (jour férié, congés,
/// événement...), dans un sens ou dans l'autre : `ouvert: false` force la
/// fermeture d'un créneau que le planning récurrent (`HoraireFermeture`)
/// laisse ouvert (fermeture exceptionnelle), `ouvert: true` force
/// l'ouverture d'un créneau qu'il ferme (ouverture exceptionnelle). L'écran
/// pré-remplit chaque créneau depuis le récurrent — une exception ne
/// représente que ce qui diffère de ce que dirait le planning par défaut. Un
/// seul créneau par ligne (contrairement à `HoraireFermeture`, pas de
/// `creneau: null` pour "journée entière") : "fermer/ouvrir toute la
/// journée" applique l'exception aux `CRENEAUX_HORAIRES` un par un.
model ExceptionHoraire {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  jour         String
  creneau      String
  ouvert       Boolean
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, jour, creneau])
  @@index([restaurantId, jour])
}

/// Un plat signature « à la cuillère » — le cœur du concept TheSpoon : des
/// restaurants où on mange à la cuillère (soupes, plats mijotés, risottos...),
/// pas juste une note en cuillères. Sert la mise en avant sur la landing et,
/// depuis l'écran "Mon menu" côté partenaire, la carte gérée par le
/// restaurant lui-même (photo, description/ingrédients, catégorie, prix).
model PlatCuillere {
  id              String        @id @default(cuid())
  nom             String
  description     String?
  categorie       CategoriePlat @default(PLAT)
  prixCentimes    Int           @default(0)
  /// Horodatage de la dernière photo uploadée (stockée sur Netlify Blobs,
  /// clé = id du plat). `null` = pas de photo, sert aussi de cache-bust pour
  /// l'URL publique `/api/plats/[id]/photo`.
  photoMisAJourLe DateTime?
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([restaurantId])
}

/// Catégorie d'un plat sur la carte — le tag entrée / plat / dessert demandé
/// par le restaurant pour organiser son menu.
enum CategoriePlat {
  ENTREE
  PLAT
  DESSERT
}

// ----------------------------------------------------------------------------
//  Socle partenaires & staff.
// ----------------------------------------------------------------------------

/// Un gérant ou un chef de salle, côté restaurant partenaire.
enum RoleContactRestaurant {
  GERANT
  CHEF_DE_SALLE
}

/// Le contact d'un restaurant partenaire — pas un dîneur. Rattaché à son
/// établissement, c'est lui qui contestera une facture (voir "Contestations &
/// litiges"). Connexion via une instance better-auth séparée de celle des
/// dîneurs (cf. `authRestaurant` dans src/lib/auth.ts) : même mécanique,
/// table dédiée, cookie dédié — une population avec ses propres accès, pas un
/// rôle de plus sur `User`.
model RestaurantContact {
  id            String                     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nom           String
  email         String
  emailVerified Boolean                    @default(false)
  image         String?
  role          RoleContactRestaurant
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  sessions      RestaurantContactSession[]
  accounts      RestaurantContactAccount[]
  dossiers      Dossier[]

  @@unique([email])
  @@index([restaurantId])
}

/// Une prise de contact d'un restaurateur pas encore partenaire — déposée
/// depuis la landing ou l'écran de connexion restaurant ("Pas encore
/// partenaire ?"), qui n'ouvrent pas de compte (voir `RestaurantContact`,
/// réservé aux établissements déjà référencés). Juste de quoi qualifier la
/// demande côté Console staff ; pas de statut de traitement pour l'instant,
/// ça arrivera avec le ticket qui décrira le suivi de ces demandes.
model DemandeContactRestaurateur {
  id            String   @id @default(cuid())
  nom           String
  email         String
  etablissement String
  message       String
  createdAt     DateTime @default(now())
}

/// L'organigramme interne TheSpoon. Pas de rôles détaillés ici (instructeur
/// litiges, validateur avoirs...) — ça arrivera avec "Auth staff TheSpoon &
/// permissions". `role` reste un texte libre affiché, pas un contrôle
/// d'accès : la Console staff est lisible par tout le staff connecté.
model Staff {
  id                String                   @id @default(cuid())
  nom               String
  email             String                   @unique
  emailVerified     Boolean                  @default(false)
  image             String?
  role              String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  sessions          StaffSession[]
  accounts          StaffAccount[]
  journalAudit      JournalAuditRestaurant[]
  dossiersInstruits Dossier[]
}

/// Action tracée dans le journal d'audit d'un restaurant partenaire.
/// `AJOUT_CONTACT` couvre l'ajout d'un contact (donc d'un accès de connexion)
/// depuis la fiche admin — voir `creerContactRestaurant`.
enum ActionAuditRestaurant {
  CREATION
  MODIFICATION
  AJOUT_CONTACT
}

/// Trace d'une création ou modification d'un restaurant partenaire, ou de
/// l'ajout d'un de ses contacts, depuis la Console staff — critère
/// d'acceptation du ticket Notion "Console staff : vue restaurants" ("toute
/// modification est tracée"), qui couvre la fiche détail dans son ensemble
/// (infos ET contacts). `champsModifies` est `null` pour une création (tout
/// est nouveau, rien à comparer) et liste pour une modification les champs
/// qui ont effectivement changé, avec leur ancienne et nouvelle valeur — pas
/// le formulaire complet, seulement le diff, pour rester lisible dans
/// l'écran qui l'affiche. Pour `AJOUT_CONTACT`, une seule entrée
/// `{champ: "contact", avant: null, apres: "<nom> (<rôle>) — <email>"}`
/// identifie le contact ajouté.
model JournalAuditRestaurant {
  id             String                @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff                 @relation(fields: [staffId], references: [id])
  action         ActionAuditRestaurant
  champsModifies Json?
  createdAt      DateTime              @default(now())

  @@index([restaurantId])
}

// ----------------------------------------------------------------------------
//  Auth restaurant partenaire (better-auth, deuxième instance — voir
//  `authRestaurant` dans src/lib/auth.ts). Mêmes tables que l'auth dîneur
//  (Session/Account/Verification), mais dédiées à `RestaurantContact` : les
//  deux populations ne partagent ni table ni cookie de session.
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
// ----------------------------------------------------------------------------

model RestaurantContactSession {
  id        String            @id
  expiresAt DateTime
  token     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      RestaurantContact @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model RestaurantContactAccount {
  id                    String            @id
  accountId             String
  providerId            String
  userId                String
  user                  RestaurantContact @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId])
}

model RestaurantContactVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ----------------------------------------------------------------------------
//  Auth staff TheSpoon (better-auth, troisième instance — voir `authAdmin`
//  dans src/lib/auth.ts). Même mécanique que l'auth restaurant partenaire,
//  table dédiée à `Staff` : les trois populations (dîneur, restaurant,
//  staff) ne partagent ni table ni cookie de session.
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
// ----------------------------------------------------------------------------

model StaffSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      Staff    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model StaffAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  Staff     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model StaffVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Statut d'une réservation. HONOREE/NO_SHOW sont posés par le restaurant
/// (voir `signaleeLe` sur `Booking`) une fois le créneau passé — c'est ce qui
/// débloque la facturation : sans couvert servi, rien à facturer.
enum StatutReservation {
  CONFIRMEE
  ANNULEE
  HONOREE
  NO_SHOW
}

/// Une réservation faite par un dîneur connecté sur la fiche établissement.
/// Pas de gestion de disponibilité/capacité ici — ce sera une story séparée
/// (espace restaurant).
model Booking {
  id             String            @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  couverts       Int
  statut         StatutReservation @default(CONFIRMEE)
  /// Nombre de couverts réellement servis, renseigné uniquement au passage en
  /// HONOREE — peut différer de `couverts` (le nombre réservé). C'est ce
  /// nombre qui sert de base à la commission facturée (epic Facturation).
  couvertsServis Int?
  /// Horodatage auquel le restaurant a signalé honoré/no-show — un attribut
  /// métier (utile pour la facturation), pas un simple `updatedAt` technique.
  signaleeLe     DateTime?
  createdAt      DateTime          @default(now())
  ligneFacture   LigneFacture?

  @@index([restaurantId])
  @@index([userId])
}

/// Une facture mensuelle de commission pour un restaurant — une par
/// (restaurant, mois), jamais recréée : voir `@@unique` ci-dessous, qui rend
/// la génération idempotente si le traitement mensuel est relancé.
model Facture {
  id                   String         @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Premier jour du mois facturé (UTC minuit) — pas la date de génération.
  mois                 DateTime
  /// Toujours la somme de `lignes.montantCentimes`, jamais saisi.
  montantTotalCentimes Int
  genereeLe            DateTime       @default(now())
  lignes               LigneFacture[]
  dossiers             Dossier[]

  @@unique([restaurantId, mois])
  @@index([restaurantId])
}

/// Une ligne de facture = une réservation honorée facturée. `bookingId` est
/// unique : une réservation ne peut être facturée qu'une seule fois, quel que
/// soit le nombre de fois où le traitement mensuel est relancé.
model LigneFacture {
  id               String          @id @default(cuid())
  factureId        String
  facture          Facture         @relation(fields: [factureId], references: [id], onDelete: Cascade)
  bookingId        String          @unique
  booking          Booking         @relation(fields: [bookingId], references: [id])
  /// Couverts pris en compte pour le calcul : `couvertsServis`, ou `couverts`
  /// (réservé) en repli si le signalement ne l'a pas renseigné.
  couvertsFactures Int
  montantCentimes  Int
  createdAt        DateTime        @default(now())
  /// Présente si cette ligne est contestée dans un dossier (voir
  /// LigneContestee) — au plus un dossier à la fois, contrainte unique côté
  /// LigneContestee.ligneFactureId.
  contestation     LigneContestee?

  @@index([factureId])
}

/// Motif de contestation d'une LigneFacture — liste fermée reprise du CANON
/// métier. Porté par LigneContestee, pas par Dossier : deux lignes d'un même
/// dossier peuvent avoir des motifs différents.
enum MotifContestation {
  NO_SHOW
  ANNULATION_TARDIVE
  COUVERTS_SURCOMPTES
  DOUBLON
  HORS_PLATEFORME
  AUTRE
}

/// Statut d'un Dossier. Seuls les deux statuts nécessaires au ticket "Dépôt
/// d'un dossier de contestation" + "Montant contesté dérivé & seuil de
/// crédit d'office" sont modélisés — la décision d'instruction manuelle
/// (accordé/partiel/refusé/escaladé, avec émission d'un Avoir) appartient à
/// "Décision & émission d'avoir", un ticket bloqué par "Instruction d'un
/// dossier" lui-même bloqué par "File des litiges à instruire" (fait — voir
/// `instructeurId`/`priseEnChargeLe` ci-dessous). Un dossier
/// EN_ATTENTE_INSTRUCTION reste donc sans suite outillée pour l'instant,
/// prise en charge mise à part : attendu, pas un oubli.
enum StatutDossier {
  EN_ATTENTE_INSTRUCTION
  CREDITE_OFFICE
}

/// Dossier de contestation déposé par un contact restaurant sur une ou
/// plusieurs lignes d'UNE facture (voir LigneContestee) — point d'entrée de
/// l'épic "Contestations & litiges". `montantContesteCentimes` n'est jamais
/// saisi : toujours la somme des lignes contestées au moment de la création
/// (voir calculerMontantConteste dans src/lib/contestation.ts). Pas
/// d'ajout/retrait de ligne après coup dans ce lot, donc pas de recalcul
/// différé à prévoir.
model Dossier {
  id                       String               @id @default(cuid())
  factureId                String
  facture                  Facture              @relation(fields: [factureId], references: [id], onDelete: Cascade)
  restaurantContactId      String
  restaurantContact        RestaurantContact    @relation(fields: [restaurantContactId], references: [id])
  commentaire              String?
  montantContesteCentimes  Int
  /// Copié depuis ConfigContestation.seuilCreditOfficeCentimes au moment de
  /// la création : changer le seuil plus tard ne réécrit jamais l'historique
  /// des dossiers déjà déposés.
  seuilAppliqueCentimes    Int
  statut                   StatutDossier        @default(EN_ATTENTE_INSTRUCTION)
  /// Staff qui a pris en charge le dossier depuis la file d'instruction
  /// ("File des litiges à instruire") — `null` tant que personne ne l'a pris.
  /// Pas de rôle "instructeur" dédié : n'importe quel membre du staff connecté
  /// peut prendre en charge, même mécanique que le reste de la Console staff.
  instructeurId            String?
  instructeur              Staff?               @relation(fields: [instructeurId], references: [id])
  /// Horodatage de la prise en charge, distinct de `createdAt` — le dossier
  /// reste EN_ATTENTE_INSTRUCTION et visible dans la file une fois pris (la
  /// décision qui le fera sortir de la file est "Décision & émission d'avoir",
  /// pas encore construite), seul l'affichage change (qui l'a pris).
  priseEnChargeLe          DateTime?
  /// Dernière demande de complément de l'instructeur au restaurant
  /// ("Instruction d'un dossier") — ne clôture pas le dossier, `null` tant
  /// que rien n'a été demandé. Un seul emplacement (pas un historique) : la
  /// trace complète de chaque demande appartient au "Journal d'événements du
  /// dossier", pas encore construit.
  complementDemandeLe      DateTime?
  complementDemandeMessage String?
  lignes                   LigneContestee[]
  piecesJointes            PieceJointeDossier[]
  createdAt                DateTime             @default(now())

  @@index([factureId])
  @@index([restaurantContactId])
  @@index([instructeurId])
}

/// Une LigneFacture contestée dans un dossier, avec son motif. `ligneFactureId`
/// est unique : une LigneFacture ne peut être rattachée qu'à un seul dossier
/// à la fois, tous statuts confondus — pas de re-contestation dans ce lot.
model LigneContestee {
  id             String            @id @default(cuid())
  dossierId      String
  dossier        Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  ligneFactureId String            @unique
  ligneFacture   LigneFacture      @relation(fields: [ligneFactureId], references: [id], onDelete: Cascade)
  motif          MotifContestation
  createdAt      DateTime          @default(now())

  @@index([dossierId])
}

/// Une pièce jointe déposée sur un dossier de contestation — rattachée au
/// dossier entier, pas à une ligne contestée (commentaire et pièces jointes
/// sont possibles sur le dossier, pas par ligne). Le fichier lui-même est
/// stocké via creerStorePhotos("dossiers-pieces-jointes"), sous la clé = id
/// de cette ligne — voir src/lib/dossier-pieces-jointes.ts. Cette ligne n'est
/// que la métadonnée.
model PieceJointeDossier {
  id           String   @id @default(cuid())
  dossierId    String
  dossier      Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  /// Nom du fichier tel qu'envoyé par le navigateur — affichage seulement,
  /// jamais utilisé comme clé de stockage.
  nomOriginal  String
  typeMime     String
  tailleOctets Int
  createdAt    DateTime @default(now())

  @@index([dossierId])
}

/// Config globale (singleton, une seule ligne, id fixe "singleton") du seuil
/// de crédit d'office — voir "Montant contesté dérivé & seuil de crédit
/// d'office". Volontairement pas une constante de code : éditable depuis la
/// page staff /admin/contestation sans déploiement. La ligne est créée
/// paresseusement au premier accès si elle n'existe pas encore — voir
/// getConfigContestation dans src/lib/contestation.ts.
model ConfigContestation {
  id                        String   @id @default("singleton")
  seuilCreditOfficeCentimes Int
  updatedAt                 DateTime @updatedAt
}

/// Un avis déposé par un dîneur après son passage dans un restaurant — un
/// seul avis par (restaurant, dîneur), modifiable (voir `deposerAvis`, qui
/// fait un upsert et recalcule `Restaurant.noteCuilleres`/`nombreAvis` à
/// chaque dépôt). Pas de modération pour l'instant : décision volontairement
/// pas prise ici, voir le ticket Notion "Modération des avis".
model Avis {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteCuilleres Int
  commentaire   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([restaurantId, userId])
  @@index([restaurantId])
}

// ----------------------------------------------------------------------------
//  Auth dîneur (better-auth). Restaurant partenaire et staff TheSpoon sont
//  des stories séparées, pas encore démarrées — un seul modèle User pour
//  l'instant, pas de champ "rôle".
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
//  Exception assumée : la relation `bookings` ci-dessous est ajoutée à la
//  main, better-auth ne gère que les champs d'auth — à recontrôler si le
//  schéma est régénéré.
// ----------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  avis          Avis[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
