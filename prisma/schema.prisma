// ============================================================================
//  TheSpoon — modèle de données
//
//  Volontairement minimal. On ne modélise pas l'entreprise fictive au complet
//  avant d'écrire du produit : chaque modèle arrive avec l'écran qui en a
//  besoin, pas avant. Voir README.md.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Un restaurant partenaire, tel qu'affiché côté dîneur (recherche + fiche).
/// Les champs de gestion interne (commission, contact, fiche technique...)
/// arriveront avec l'espace restaurant et le BO admin.
model Restaurant {
  id            String   @id @default(cuid())
  nom           String
  ville         String
  cuisine       String
  adresse       String
  horaires      String?
  description   String?
  capacite      Int?
  noteCuilleres Float?
  nombreAvis    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  platsCuillere PlatCuillere[]
  bookings      Booking[]

  @@index([ville])
  @@index([cuisine])
}

/// Un plat signature « à la cuillère » — le cœur du concept TheSpoon : des
/// restaurants où on mange à la cuillère (soupes, plats mijotés, risottos...),
/// pas juste une note en cuillères. Sert la mise en avant sur la landing.
model PlatCuillere {
  id           String     @id @default(cuid())
  nom          String
  description  String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

/// Une réservation faite par un dîneur connecté sur la fiche établissement.
/// Pas de gestion de disponibilité/capacité ni d'annulation ici — ce sont
/// des stories séparées ("Gestion de ma réservation", espace restaurant).
model Booking {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  couverts     Int
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
//  Auth dîneur (better-auth). Restaurant partenaire et staff TheSpoon sont
//  des stories séparées, pas encore démarrées — un seul modèle User pour
//  l'instant, pas de champ "rôle".
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
//  Exception assumée : la relation `bookings` ci-dessous est ajoutée à la
//  main, better-auth ne gère que les champs d'auth — à recontrôler si le
//  schéma est régénéré.
// ----------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
