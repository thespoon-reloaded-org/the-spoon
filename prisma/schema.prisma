// ============================================================================
//  TheSpoon — modèle de données
//
//  Volontairement minimal. On ne modélise pas l'entreprise fictive au complet
//  avant d'écrire du produit : chaque modèle arrive avec l'écran qui en a
//  besoin, pas avant. Voir README.md.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Un restaurant partenaire, tel qu'affiché côté dîneur (recherche + fiche).
/// Les champs de gestion interne (commission, contact, fiche technique...)
/// arriveront avec l'espace restaurant et le BO admin.
model Restaurant {
  id                    String    @id @default(cuid())
  nom                   String
  ville                 String
  cuisine               String
  adresse               String
  /// Ancien champ texte des horaires ("Mar-Sam 12h-14h, 19h-22h30"), remplacé
  /// par `PlageOuverture` : plus aucun écran ne le lit ni ne l'écrit. Il
  /// survit en base le temps de vérifier qu'aucune fiche de production ne
  /// portait un format que la migration de reprise n'a pas su relire — le
  /// supprimer à l'aveugle effacerait des horaires irrécupérables. Voir le
  /// ticket « Supprimer Restaurant.horaires ».
  horaires              String?
  description           String?
  capacite              Int?
  /// Délai (en heures) avant le créneau au-delà duquel une annulation est
  /// jugée tardive — `null` : pas de politique définie. Prérequis du délai
  /// minimal d'annulation côté dîneur et du futur motif de contestation
  /// `annulation_tardive`, ni l'un ni l'autre pas encore appliqués.
  delaiAnnulationHeures Int?
  noteCuilleres         Float?
  nombreAvis            Int       @default(0)
  /// Horodatage de la dernière photo uploadée (même mécanique que
  /// `PlatCuillere.photoMisAJourLe` — voir src/lib/photos.ts). `null` = pas
  /// de photo, sert aussi de cache-bust pour `/api/restaurants/[id]/photo`.
  photoMisAJourLe       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  platsCuillere      PlatCuillere[]
  bookings           Booking[]
  avis               Avis[]
  contacts           RestaurantContact[]
  plagesOuverture    PlageOuverture[]
  exceptionsHoraires ExceptionHoraire[]
  journalAudit       JournalAuditRestaurant[]
  factures           Facture[]

  @@index([ville])
  @@index([cuisine])
}

/// Les horaires d'ouverture déclarés du restaurant, sous une forme qui sert
/// à la fois à les afficher sur la fiche et à décider des créneaux proposés
/// au dîneur — c'était là le défaut : la fiche affichait un texte libre
/// (`Restaurant.horaires`, supprimé avec ce modèle) pendant que la carte de
/// réservation proposait les douze créneaux de `CRENEAUX_HORAIRES` sans le
/// lire. Une plage = un service continu sur un jour de semaine ISO
/// (0 = lundi … 6 = dimanche, voir `jourSemaineIso`) ; ouvert midi et soir =
/// deux plages sur le même jour.
///
/// Remplace aussi l'ancien `HoraireFermeture`, qui disait la même chose à
/// l'envers (un créneau réservable fermé) : deux représentations d'une même
/// question n'ont pas à coexister. Les exceptions datées ci-dessous, elles,
/// restent — elles répondent à une autre question.
///
/// Un jour sans plage est fermé. **Aucune plage sur tout le restaurant** est
/// le seul cas où « pas de plage » ne veut pas dire fermé : le restaurant
/// n'a rien déclaré, tous les créneaux restent proposés (voir
/// `horairesDeclares`, src/lib/horaires.ts).
model PlageOuverture {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  jourSemaine  Int
  /// Minutes depuis minuit (12h00 = 720), borne incluse.
  debutMinutes Int
  /// Minutes depuis minuit, borne exclue : on ne s'attable pas à l'heure de
  /// fermeture. Un service 19h–22h30 laisse donc réserver à 22h, pas à 22h30.
  finMinutes   Int
  createdAt    DateTime   @default(now())

  @@index([restaurantId, jourSemaine])
}

/// Une exception ponctuelle sur une date précise (jour férié, congés,
/// événement...), dans un sens ou dans l'autre : `ouvert: false` ferme un
/// créneau que les horaires d'ouverture (`PlageOuverture`) laissent ouvert,
/// `ouvert: true` ouvre un créneau qu'ils ferment. L'écran pré-remplit
/// chaque créneau depuis les horaires habituels — une exception ne
/// représente que ce qui diffère d'eux ce jour-là. Un seul créneau par
/// ligne : "fermer/ouvrir toute la journée" applique l'exception aux
/// `CRENEAUX_HORAIRES` un par un.
model ExceptionHoraire {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  jour         String
  creneau      String
  ouvert       Boolean
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, jour, creneau])
  @@index([restaurantId, jour])
}

/// Un plat signature « à la cuillère » — le cœur du concept TheSpoon : des
/// restaurants où on mange à la cuillère (soupes, plats mijotés, risottos...),
/// pas juste une note en cuillères. Sert la mise en avant sur la landing et,
/// depuis l'écran "Mon menu" côté partenaire, la carte gérée par le
/// restaurant lui-même (photo, description/ingrédients, catégorie, prix).
model PlatCuillere {
  id                   String        @id @default(cuid())
  nom                  String
  description          String?
  categorie            CategoriePlat @default(PLAT)
  prixCentimes         Int           @default(0)
  /// Horodatage de la dernière photo uploadée (stockée sur Netlify Blobs,
  /// clé = id du plat). `null` = pas de photo, sert aussi de cache-bust pour
  /// l'URL publique `/api/plats/[id]/photo`.
  photoMisAJourLe      DateTime?
  /// Les allergènes présents dans le plat, déclarés par le restaurant.
  /// Une liste vide ne veut rien dire toute seule — voir
  /// `allergenesDeclaresLe`.
  allergenes           Allergene[]
  /// Quand le restaurant a déclaré les allergènes de ce plat. `null` = jamais
  /// déclaré, et c'est toute la différence : une liste vide **non datée** est
  /// un plat qu'on n'a pas renseigné, une liste vide **datée** est un plat dont
  /// le restaurant affirme qu'aucun des 14 allergènes majeurs n'y figure. Les
  /// confondre reviendrait à rassurer un dîneur allergique sur la foi d'un
  /// champ que personne n'a rempli.
  allergenesDeclaresLe DateTime?
  restaurantId         String
  restaurant           Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())

  @@index([restaurantId])
}

/// Catégorie d'un plat sur la carte — le tag entrée / plat / dessert demandé
/// par le restaurant pour organiser son menu.
enum CategoriePlat {
  ENTREE
  PLAT
  DESSERT
}

/// Les quatorze allergènes à déclaration obligatoire en restauration
/// (annexe II du règlement UE n° 1169/2011, dit « INCO »). La liste est
/// réglementaire et fermée : c'est pour ça que c'est un enum et pas du texte
/// libre — un dîneur qui filtre « sans gluten » ne peut pas le faire sur des
/// orthographes libres, et l'ordre ci-dessous est celui de l'annexe.
enum Allergene {
  GLUTEN
  CRUSTACES
  OEUFS
  POISSONS
  ARACHIDES
  SOJA
  LAIT
  FRUITS_A_COQUE
  CELERI
  MOUTARDE
  SESAME
  SULFITES
  LUPIN
  MOLLUSQUES
}

// ----------------------------------------------------------------------------
//  Socle partenaires & staff.
// ----------------------------------------------------------------------------

/// Un gérant ou un chef de salle, côté restaurant partenaire.
enum RoleContactRestaurant {
  GERANT
  CHEF_DE_SALLE
}

/// Le contact d'un restaurant partenaire — pas un dîneur. Rattaché à son
/// établissement, c'est lui qui contestera une facture (voir "Contestations &
/// litiges"). Connexion via une instance better-auth séparée de celle des
/// dîneurs (cf. `authRestaurant` dans src/lib/auth.ts) : même mécanique,
/// table dédiée, cookie dédié — une population avec ses propres accès, pas un
/// rôle de plus sur `User`.
model RestaurantContact {
  id             String                     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nom            String
  email          String
  emailVerified  Boolean                    @default(false)
  image          String?
  role           RoleContactRestaurant
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  /// Date à laquelle cette personne a vu l'onboarding de son parcours jusqu'au
  /// bout. `null` : jamais vu, il s'ouvre tout seul à l'arrivée. Une fois
  /// renseigné il ne se rouvre plus seul, mais reste rejouable depuis le
  /// menu — d'où une date plutôt qu'un booléen : « quand » se relit, « vrai »
  /// ne dit rien.
  onboardingVuLe DateTime?
  sessions       RestaurantContactSession[]
  accounts       RestaurantContactAccount[]
  dossiers       Dossier[]

  @@unique([email])
  @@index([restaurantId])
}

/// Une prise de contact d'un restaurateur pas encore partenaire — déposée
/// depuis la landing ou l'écran de connexion restaurant ("Pas encore
/// partenaire ?"), qui n'ouvrent pas de compte (voir `RestaurantContact`,
/// réservé aux établissements déjà référencés). Juste de quoi qualifier la
/// demande côté Console staff ; pas de statut de traitement pour l'instant,
/// ça arrivera avec le ticket qui décrira le suivi de ces demandes.
model DemandeContactRestaurateur {
  id                  String   @id @default(cuid())
  nom                 String
  email               String
  etablissement       String
  /// Nullable : les demandes déposées avant l'ajout du champ n'en ont pas.
  adresse             String?
  /// Nullable : les demandes déposées avant l'ajout du champ n'en ont pas, et
  /// un journal de demandes ne se réécrit pas. Neuf chiffres, stockés sans
  /// espace. Sert au staff à identifier l'entreprise sans la rechercher à la
  /// main.
  siren               String?
  /// Nullable : facultatif y compris pour les nouvelles demandes, et absent
  /// des demandes antérieures. La fiche Google My Business de l'établissement,
  /// pour situer son activité sans la vérifier hors de sa forme.
  urlGoogleMyBusiness String?
  /// Nullable : les demandes antérieures n'ont pas la réponse. Le critère
  /// d'éligibilité de TheSpoon, déclaré par le restaurateur (oui / non), pas
  /// deviné par le staff.
  menusALaCuillere    Boolean?
  message             String
  createdAt           DateTime @default(now())
}

/// L'organigramme interne TheSpoon. Pas de rôles détaillés ici (instructeur
/// litiges, validateur avoirs...) — ça arrivera avec "Auth staff TheSpoon &
/// permissions". `role` reste un texte libre affiché, pas un contrôle
/// d'accès : la Console staff est lisible par tout le staff connecté.
model Staff {
  id                String                   @id @default(cuid())
  nom               String
  email             String                   @unique
  emailVerified     Boolean                  @default(false)
  image             String?
  role              String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  /// Date à laquelle cette personne a vu l'onboarding de son parcours jusqu'au
  /// bout. `null` : jamais vu, il s'ouvre tout seul à l'arrivée. Une fois
  /// renseigné il ne se rouvre plus seul, mais reste rejouable depuis le
  /// menu — d'où une date plutôt qu'un booléen : « quand » se relit, « vrai »
  /// ne dit rien.
  onboardingVuLe    DateTime?
  sessions          StaffSession[]
  accounts          StaffAccount[]
  journalAudit      JournalAuditRestaurant[]
  dossiersInstruits Dossier[]
  decisionsPrises   DecisionDossier[]
  evenementsDossier EvenementDossier[]
}

/// Action tracée dans le journal d'audit d'un restaurant partenaire.
/// `AJOUT_CONTACT` couvre l'ajout d'un contact (donc d'un accès de connexion)
/// depuis la fiche admin — voir `creerContactRestaurant`.
enum ActionAuditRestaurant {
  CREATION
  MODIFICATION
  AJOUT_CONTACT
}

/// Trace d'une création ou modification d'un restaurant partenaire, ou de
/// l'ajout d'un de ses contacts, depuis la Console staff — critère
/// d'acceptation du ticket Notion "Console staff : vue restaurants" ("toute
/// modification est tracée"), qui couvre la fiche détail dans son ensemble
/// (infos ET contacts). `champsModifies` est `null` pour une création (tout
/// est nouveau, rien à comparer) et liste pour une modification les champs
/// qui ont effectivement changé, avec leur ancienne et nouvelle valeur — pas
/// le formulaire complet, seulement le diff, pour rester lisible dans
/// l'écran qui l'affiche. Pour `AJOUT_CONTACT`, une seule entrée
/// `{champ: "contact", avant: null, apres: "<nom> (<rôle>) — <email>"}`
/// identifie le contact ajouté.
model JournalAuditRestaurant {
  id             String                @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff                 @relation(fields: [staffId], references: [id])
  action         ActionAuditRestaurant
  champsModifies Json?
  createdAt      DateTime              @default(now())

  @@index([restaurantId])
}

// ----------------------------------------------------------------------------
//  Auth restaurant partenaire (better-auth, deuxième instance — voir
//  `authRestaurant` dans src/lib/auth.ts). Mêmes tables que l'auth dîneur
//  (Session/Account/Verification), mais dédiées à `RestaurantContact` : les
//  deux populations ne partagent ni table ni cookie de session.
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
// ----------------------------------------------------------------------------

model RestaurantContactSession {
  id        String            @id
  expiresAt DateTime
  token     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      RestaurantContact @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model RestaurantContactAccount {
  id                    String            @id
  accountId             String
  providerId            String
  userId                String
  user                  RestaurantContact @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId])
}

model RestaurantContactVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ----------------------------------------------------------------------------
//  Auth staff TheSpoon (better-auth, troisième instance — voir `authAdmin`
//  dans src/lib/auth.ts). Même mécanique que l'auth restaurant partenaire,
//  table dédiée à `Staff` : les trois populations (dîneur, restaurant,
//  staff) ne partagent ni table ni cookie de session.
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
// ----------------------------------------------------------------------------

model StaffSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      Staff    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model StaffAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  Staff     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model StaffVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Statut d'une réservation. HONOREE/NO_SHOW sont posés par le restaurant
/// (voir `signaleeLe` sur `Booking`) une fois le créneau passé — c'est ce qui
/// débloque la facturation : sans couvert servi, rien à facturer.
enum StatutReservation {
  CONFIRMEE
  ANNULEE
  HONOREE
  NO_SHOW
}

/// Une réservation faite par un dîneur connecté sur la fiche établissement.
/// Pas de gestion de disponibilité/capacité ici — ce sera une story séparée
/// (espace restaurant).
model Booking {
  id                String            @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  couverts          Int
  statut            StatutReservation @default(CONFIRMEE)
  /// Nombre de couverts réellement servis, renseigné uniquement au passage en
  /// HONOREE — peut différer de `couverts` (le nombre réservé). C'est ce
  /// nombre qui sert de base à la commission facturée (epic Facturation).
  couvertsServis    Int?
  /// Horodatage auquel le restaurant a signalé honoré/no-show — un attribut
  /// métier (utile pour la facturation), pas un simple `updatedAt` technique.
  signaleeLe        DateTime?
  /// Le dîneur a prévenu qu'il ne viendrait pas, alors qu'il ne pouvait plus
  /// annuler (délai du restaurant dépassé). La réservation reste CONFIRMEE :
  /// c'est le restaurant qui tranche honoré/no-show à la fin, ce signal ne
  /// décide rien à sa place. Il s'affiche sur "Réservations reçues", avant le
  /// service (libérer la table) comme après (choisir honoré ou no-show en
  /// connaissance de cause). Sans effet sur la facturation — seules les
  /// réservations HONOREE sont facturées — et pas encore repris par les
  /// écrans de litige, où la trace serait pourtant utile.
  absencePrevenueLe DateTime?
  createdAt         DateTime          @default(now())
  ligneFacture      LigneFacture?

  @@index([restaurantId])
  @@index([userId])
}

/// Une facture mensuelle de commission pour un restaurant — une par
/// (restaurant, mois), jamais recréée : voir `@@unique` ci-dessous, qui rend
/// la génération idempotente si le traitement mensuel est relancé.
model Facture {
  id                   String         @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Premier jour du mois facturé (UTC minuit) — pas la date de génération.
  mois                 DateTime
  /// Toujours la somme de `lignes.montantCentimes`, jamais saisi.
  montantTotalCentimes Int
  genereeLe            DateTime       @default(now())
  lignes               LigneFacture[]
  dossiers             Dossier[]
  /// Avoirs émis sur cette facture à la suite d'une contestation. Ils ne
  /// touchent pas `montantTotalCentimes` : une facture émise ne se réécrit
  /// pas, elle se corrige par un avoir (voir `montantAvoirs` /
  /// `netAPayerCentimes` dans src/lib/facturation.ts).
  avoirs               Avoir[]

  @@unique([restaurantId, mois])
  @@index([restaurantId])
}

/// Une ligne de facture = une réservation honorée facturée. `bookingId` est
/// unique : une réservation ne peut être facturée qu'une seule fois, quel que
/// soit le nombre de fois où le traitement mensuel est relancé.
model LigneFacture {
  id               String          @id @default(cuid())
  factureId        String
  facture          Facture         @relation(fields: [factureId], references: [id], onDelete: Cascade)
  bookingId        String          @unique
  booking          Booking         @relation(fields: [bookingId], references: [id])
  /// Couverts pris en compte pour le calcul : `couvertsServis`, ou `couverts`
  /// (réservé) en repli si le signalement ne l'a pas renseigné.
  couvertsFactures Int
  montantCentimes  Int
  createdAt        DateTime        @default(now())
  /// Présente si cette ligne est contestée dans un dossier (voir
  /// LigneContestee) — au plus un dossier à la fois, contrainte unique côté
  /// LigneContestee.ligneFactureId.
  contestation     LigneContestee?

  @@index([factureId])
}

/// Motif de contestation d'une LigneFacture — liste fermée reprise du CANON
/// métier. Porté par LigneContestee, pas par Dossier : deux lignes d'un même
/// dossier peuvent avoir des motifs différents.
enum MotifContestation {
  NO_SHOW
  ANNULATION_TARDIVE
  COUVERTS_SURCOMPTES
  DOUBLON
  HORS_PLATEFORME
  AUTRE
}

/// Où en est un Dossier — pas ce qu'il a obtenu. EN_ATTENTE_INSTRUCTION et
/// ESCALADE sont les deux états "reste à trancher" (voir `deciderDossier`
/// dans src/lib/contestation.ts) ; CREDITE_OFFICE et CLOTURE sont terminaux.
/// Ce qui a été décidé se lit sur la DecisionDossier la plus récente, jamais
/// ici : un même statut CLOTURE couvre un accord comme un refus.
enum StatutDossier {
  EN_ATTENTE_INSTRUCTION
  /// Sous le seuil : crédité sans instruction humaine. Porte quand même une
  /// décision et un avoir, émis à la création du dossier.
  CREDITE_OFFICE
  /// Instruit, mais passé à quelqu'un d'autre : sorti de la file d'attente
  /// normale, toujours à trancher.
  ESCALADE
  /// Tranché — accordé, partiel ou refusé.
  CLOTURE
}

/// Dossier de contestation déposé par un contact restaurant sur une ou
/// plusieurs lignes d'UNE facture (voir LigneContestee) — point d'entrée de
/// l'épic "Contestations & litiges". `montantContesteCentimes` n'est jamais
/// saisi : toujours la somme des lignes contestées au moment de la création
/// (voir calculerMontantConteste dans src/lib/contestation.ts). Pas
/// d'ajout/retrait de ligne après coup dans ce lot, donc pas de recalcul
/// différé à prévoir.
model Dossier {
  id                       String               @id @default(cuid())
  factureId                String
  facture                  Facture              @relation(fields: [factureId], references: [id], onDelete: Cascade)
  restaurantContactId      String
  restaurantContact        RestaurantContact    @relation(fields: [restaurantContactId], references: [id])
  commentaire              String?
  montantContesteCentimes  Int
  /// Copié depuis ConfigContestation.seuilCreditOfficeCentimes au moment de
  /// la création : changer le seuil plus tard ne réécrit jamais l'historique
  /// des dossiers déjà déposés.
  seuilAppliqueCentimes    Int
  statut                   StatutDossier        @default(EN_ATTENTE_INSTRUCTION)
  /// Staff qui a pris en charge le dossier depuis la file d'instruction
  /// ("File des litiges à instruire") — `null` tant que personne ne l'a pris.
  /// Pas de rôle "instructeur" dédié : n'importe quel membre du staff connecté
  /// peut prendre en charge, même mécanique que le reste de la Console staff.
  instructeurId            String?
  instructeur              Staff?               @relation(fields: [instructeurId], references: [id])
  /// Horodatage de la prise en charge, distinct de `createdAt` — le dossier
  /// reste EN_ATTENTE_INSTRUCTION et visible dans la file une fois pris,
  /// seul l'affichage change (qui l'a pris). C'est la décision qui le fait
  /// sortir de la file, pas la prise en charge.
  priseEnChargeLe          DateTime?
  /// Dernière demande de complément de l'instructeur au restaurant
  /// ("Instruction d'un dossier") — ne clôture pas le dossier, `null` tant
  /// que rien n'a été demandé. Un seul emplacement (pas un historique) : la
  /// trace complète de chaque demande appartient au "Journal d'événements du
  /// dossier", pas encore construit.
  complementDemandeLe      DateTime?
  complementDemandeMessage String?
  lignes                   LigneContestee[]
  piecesJointes            PieceJointeDossier[]
  evenements               EvenementDossier[]
  /// Toutes les instructions tranchées de ce dossier, la plus récente faisant
  /// foi — une réinstruction ajoute une ligne, elle n'écrase pas la première.
  decisions                DecisionDossier[]
  createdAt                DateTime             @default(now())

  @@index([factureId])
  @@index([restaurantContactId])
  @@index([instructeurId])
}

/// Une LigneFacture contestée dans un dossier, avec son motif. `ligneFactureId`
/// est unique : une LigneFacture ne peut être rattachée qu'à un seul dossier
/// à la fois, tous statuts confondus — pas de re-contestation dans ce lot.
model LigneContestee {
  id             String            @id @default(cuid())
  dossierId      String
  dossier        Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  ligneFactureId String            @unique
  ligneFacture   LigneFacture      @relation(fields: [ligneFactureId], references: [id], onDelete: Cascade)
  motif          MotifContestation
  createdAt      DateTime          @default(now())

  @@index([dossierId])
}

/// Une pièce jointe déposée sur un dossier de contestation — rattachée au
/// dossier entier, pas à une ligne contestée (commentaire et pièces jointes
/// sont possibles sur le dossier, pas par ligne). Le fichier lui-même est
/// stocké via creerStorePhotos("dossiers-pieces-jointes"), sous la clé = id
/// de cette ligne — voir src/lib/dossier-pieces-jointes.ts. Cette ligne n'est
/// que la métadonnée.
model PieceJointeDossier {
  id           String   @id @default(cuid())
  dossierId    String
  dossier      Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  /// Nom du fichier tel qu'envoyé par le navigateur — affichage seulement,
  /// jamais utilisé comme clé de stockage.
  nomOriginal  String
  typeMime     String
  tailleOctets Int
  createdAt    DateTime @default(now())

  @@index([dossierId])
}

/// Config globale (singleton, une seule ligne, id fixe "singleton") du seuil
/// de crédit d'office — voir "Montant contesté dérivé & seuil de crédit
/// d'office". Volontairement pas une constante de code : éditable depuis la
/// page staff /admin/contestation sans déploiement. La ligne est créée
/// paresseusement au premier accès si elle n'existe pas encore — voir
/// getConfigContestation dans src/lib/contestation.ts.
model ConfigContestation {
  id                        String   @id @default("singleton")
  seuilCreditOfficeCentimes Int
  updatedAt                 DateTime @updatedAt
}

/// Étape d'un dossier de contestation, telle qu'elle apparaît dans son
/// journal. Une décision et l'avoir qu'elle émet sont deux événements
/// distincts : un accord partiel refusé en relecture laisserait sinon croire
/// que rien n'a été crédité.
///
/// Les valeurs sont déclarées dans leur ordre chronologique, et les écrans
/// s'en servent : plusieurs événements d'un même dossier peuvent partager
/// l'horodatage à la milliseconde près (dépôt et crédit d'office sont écrits
/// dans la même transaction), et Postgres trie un enum selon cet ordre de
/// déclaration. Ne pas réordonner cette liste.
enum TypeEvenementDossier {
  DEPOT
  PRISE_EN_CHARGE
  COMPLEMENT_DEMANDE
  DECISION
  AVOIR_EMIS
}

/// Journal d'un dossier : qui a fait quoi, quand. En ajout seul — rien dans
/// le produit ne modifie ni ne supprime une ligne, c'est ce qui en fait une
/// preuve. Il rend le délai d'instruction mesurable, et il est la seule trace
/// complète des demandes de complément : le dossier, lui, n'en garde que la
/// dernière.
model EvenementDossier {
  id            String               @id @default(cuid())
  dossierId     String
  dossier       Dossier              @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type          TypeEvenementDossier
  /// Ce qui varie d'un type à l'autre (montant, issue, message), figé à
  /// l'écriture : un journal se relit des mois plus tard et ne doit pas
  /// dépendre de l'état courant du dossier. Même approche que
  /// `JournalAuditRestaurant.champsModifies`.
  details       Json?
  /// Membre du staff auteur du geste. `null` quand il vient du restaurant
  /// (dépôt) ou d'un traitement automatique (crédit d'office).
  auteurStaffId String?
  auteurStaff   Staff?               @relation(fields: [auteurStaffId], references: [id])
  /// Geste d'organisation interne, invisible côté partenaire : la prise en
  /// charge et l'escalade regardent l'équipe Partenaires, pas lui. La règle
  /// est posée à l'écriture plutôt que déduite du type à l'affichage — une
  /// décision est visible, sauf quand elle escalade.
  interne       Boolean              @default(false)
  createdAt     DateTime             @default(now())

  @@index([dossierId])
  @@index([auteurStaffId])
}

/// Issue d'une instruction, reprise du CANON métier. ESCALADE n'est pas une
/// issue finale : elle passe la main sans rien accorder ni refuser.
enum IssueDecision {
  ACCORDE
  PARTIEL
  REFUSE
  ESCALADE
}

/// Qui porte le coût du litige. RESTAURANT : la facture reste due telle
/// quelle, aucun avoir. THESPOON : la plateforme renonce à sa commission.
/// CLIENT : la responsabilité revient au dîneur — le restaurant est crédité
/// quand même, et TheSpoon peut refacturer des frais de no-show au dîneur
/// (ticket séparé "Frais de no-show au dîneur", sujet juridique à part).
enum ImputationLitige {
  RESTAURANT
  THESPOON
  CLIENT
}

/// Une instruction tranchée. Entité séparée, jamais des colonnes de Dossier :
/// un dossier peut être réinstruit (escalade, relecture qualité, contestation
/// de la décision) et on doit pouvoir comparer deux instructions du même
/// dossier au lieu d'écraser la première.
model DecisionDossier {
  id                     String            @id @default(cuid())
  dossierId              String
  dossier                Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  issue                  IssueDecision
  /// Montant réellement crédité au restaurant. 0 sur un refus et sur une
  /// escalade ; jamais supérieur au montant contesté du dossier (voir
  /// `normaliserDecision` dans src/lib/contestation.ts).
  montantAccordeCentimes Int
  /// `null` sur une escalade seulement : tant que rien n'est tranché,
  /// personne ne porte le coût.
  imputation             ImputationLitige?
  /// Motivation transmise au restaurant, obligatoire y compris sur un refus —
  /// c'est la seule réponse qu'il reçoit sur son dossier.
  motif                  String
  /// Staff qui a tranché. `null` pour un crédit d'office : c'est la règle de
  /// seuil qui décide, pas une personne.
  decideParId            String?
  decidePar              Staff?            @relation(fields: [decideParId], references: [id])
  avoir                  Avoir?
  createdAt              DateTime          @default(now())

  @@index([dossierId])
  @@index([decideParId])
}

/// L'avoir émis au restaurant quand une décision lui accorde quelque chose —
/// TheSpoon ne rembourse pas, elle crédite ce qu'elle a facturé.
///
/// L'idempotence demandée par le ticket ("rejouer l'opération ne crédite pas
/// deux fois") tient à deux verrous, pas à un : `decisionId` est unique ici,
/// et une décision ne peut être prise que par une transition de statut
/// atomique sur le dossier (voir `deciderDossier`). Le premier interdit deux
/// avoirs pour une même décision, le second interdit deux décisions pour un
/// même dossier en attente.
model Avoir {
  id              String          @id @default(cuid())
  decisionId      String          @unique
  decision        DecisionDossier @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// Redondant avec `decision.dossier.factureId`, et assumé : c'est ce qui
  /// permet de lire les avoirs d'une facture sans traverser deux relations,
  /// sur un lien qui ne bouge jamais (un dossier ne change pas de facture).
  factureId       String
  facture         Facture         @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montantCentimes Int
  emisLe          DateTime        @default(now())

  @@index([factureId])
}

/// Un top 10 servi par l'assistant de recherche de l'accueil (voir
/// src/lib/chatbot/agent.ts), et le verdict du dîneur dessus — cœur plein ou
/// cœur brisé. Garder la proposition elle-même, et pas seulement le vote,
/// c'est ce qui rend le vote lisible : on sait ce qui a plu ou déplu, pour
/// quelle demande. Anonyme : l'assistant est ouvert sans connexion, et rien
/// ici ne rattache une demande à un dîneur.
model PropositionAssistant {
  id            String              @id @default(cuid())
  /// Les messages du dîneur dans la conversation, dans l'ordre.
  demande       String
  /// La réponse de l'assistant qui accompagnait la liste.
  message       String
  /// Les restaurants proposés, dans l'ordre du classement. Pas de relation :
  /// un restaurant supprimé ne doit pas effacer l'historique des votes.
  restaurantIds String[]
  /// Tous les restaurants que les recherches de l'agent ont renvoyés pour
  /// cette demande — ceux qu'il aurait pu proposer. Comparé à
  /// `restaurantIds`, c'est ce qui mesure l'exposition d'un restaurant
  /// rapportée à son éligibilité : sans lui, on confondrait un biais du
  /// classement avec la forme du catalogue.
  candidatIds   String[]
  verdict       VerdictProposition?
  verdictLe     DateTime?
  createdAt     DateTime            @default(now())

  @@index([createdAt])
}

enum VerdictProposition {
  AIME
  AIME_PAS
}

/// Un avis déposé par un dîneur après son passage dans un restaurant — un
/// seul avis par (restaurant, dîneur), modifiable (voir `deposerAvis`, qui
/// fait un upsert et recalcule `Restaurant.noteCuilleres`/`nombreAvis` à
/// chaque dépôt). Pas de modération pour l'instant : décision volontairement
/// pas prise ici, voir le ticket Notion "Modération des avis".
model Avis {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteCuilleres Int
  commentaire   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([restaurantId, userId])
  @@index([restaurantId])
}

// ----------------------------------------------------------------------------
//  Auth dîneur (better-auth). Restaurant partenaire et staff TheSpoon sont
//  des stories séparées, pas encore démarrées — un seul modèle User pour
//  l'instant, pas de champ "rôle".
//  Schéma généré par `npx @better-auth/cli generate`, ne pas modifier à la
//  main : régénérer plutôt après un changement de config dans src/lib/auth.ts.
//  Exception assumée : la relation `bookings` ci-dessous est ajoutée à la
//  main, better-auth ne gère que les champs d'auth — à recontrôler si le
//  schéma est régénéré.
// ----------------------------------------------------------------------------

model User {
  id             String    @id
  name           String
  email          String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Date à laquelle cette personne a vu l'onboarding de son parcours jusqu'au
  /// bout. `null` : jamais vu, il s'ouvre tout seul à l'arrivée. Une fois
  /// renseigné il ne se rouvre plus seul, mais reste rejouable depuis le
  /// menu — d'où une date plutôt qu'un booléen : « quand » se relit, « vrai »
  /// ne dit rien.
  onboardingVuLe DateTime?
  sessions       Session[]
  accounts       Account[]
  bookings       Booking[]
  avis           Avis[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
