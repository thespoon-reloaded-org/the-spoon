# Base de données PostgreSQL
#
# En local (installée via `brew install postgresql@17`) : remplacez
# VOTRE_UTILISATEUR_MAC par le résultat de la commande `whoami`.
DATABASE_URL="postgresql://VOTRE_UTILISATEUR_MAC@localhost:5432/thespoon_dev"

# Auth (better-auth). Générer BETTER_AUTH_SECRET avec `openssl rand -hex 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3100"
